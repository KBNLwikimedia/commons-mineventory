# Kopieer naar .env en vul in. Commit .env nooit.
# Instellingen die een beheerder later in het beheerpaneel kan wijzigen (fase 2),
# zijn hier alleen de beginwaarden.

# Detectie: dummy (fase 1) of live (Meta Model API; alleen na een opdracht van Olaf)
DETECTIE_MODUS=dummy
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
SAM_MODEL=sam-3.1

# Limieten (FO 6.4): per gebruiker, in totaal, en een dagbudget in dollars
DAGLIMIET_PER_GEBRUIKER=100
DAGLIMIET_AANROEPEN=500
DAGBUDGET_USD=2

# Beschrijving met Muse Spark (FO 6.2 en 6.3). Contributor alleen bij publiek domein
# zonder rechtenlabels, en alleen als het aan staat.
BEELDMODEL=muse-spark-1.3
BEELDMODEL_RECHTENVRIJ=muse-spark-1.3-contributor
BEELDMODEL_CONTRIBUTOR=aan
# Redeneerinspanning: minimal, low, medium, high, xhigh, max, of auto (het model kiest)
BEELDMODEL_REDENEREN=low

# Wikimedia Commons netjes gebruiken: eigen User-Agent, ±1 verzoek per seconde, cache
COMMONS_API=https://commons.wikimedia.org/w/api.php
WIKIDATA_API=https://www.wikidata.org/w/api.php
COMMONS_USER_AGENT=CommonsCutter/0.1 (https://github.com/KBNLwikimedia/commons-cutter; experiment) python-requests
COMMONS_MIN_INTERVAL=1.0
COMMONS_TIMEOUT=60
COMMONS_CACHE_SECONDEN=86400
# Uploaden naar Commons (fase 2): uit tot Olaf anders zegt
COMMONS_UPLOAD=uit
# Grote bestanden: uitsnijden in volledige resolutie tot zoveel megapixel (FO 5.4)
MAX_MEGAPIXELS=100

# Inloggen en beheer (fase 2). Geheimen alleen hier of met toolforge envvars.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
COMMONS_OWNER_TOKEN=
FLASK_SECRET_KEY=
TOEGESTANE_GEBRUIKERS=OlafJanssen
BEHEERDERS_START=OlafJanssen

# Bewaartermijnen in dagen, vanaf het laatste gebruik (FO 12.1)
BEWAAR_ORIGINELEN_DAGEN=7
BEWAAR_UITSNEDEN_DAGEN=30
BEWAAR_CACHE_DAGEN=365

# Opslag (standaard: cache/ en uitvoer/ in de projectmap)
CACHE_DIR=
UITVOER_DIR=

# Frontend: Vite-devserver (npm run dev) of de gebouwde bestanden (npm run build).
# auto = devserver als Flask in debug draait en de devserver bereikbaar is.
VITE_DEV=auto
VITE_DEV_SERVER=http://localhost:5173

# Link naar de broncode in de footer
BRONCODE_URL=https://github.com/KBNLwikimedia/commons-cutter
